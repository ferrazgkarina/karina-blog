---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lastUpdated = 'September 29, 2026';
import { siteConfig } from '../config/site';
const contactEmail = siteConfig.contactEmail;

type Block =
  | { type: 'p'; text: string }
  | { type: 'ul'; items: string[] }
  | { type: 'h3'; text: string }
  | { type: 'email' };

interface PolicySection {
  heading: string;
  blocks: Block[];
}

const sections: PolicySection[] = [
  {
    heading: 'Who we are',
    blocks: [
      {
        type: 'p',
        text: `${siteConfig.name} is an independent travel blog providing destination information and recommendations for travelers.`,
      },
      { type: 'p', text: 'If you have any questions regarding this Privacy Policy, you can contact us at:' },
      { type: 'email' },
    ],
  },
  {
    heading: 'Information we collect',
    blocks: [
      { type: 'p', text: 'We may collect information in the following ways:' },
      { type: 'h3', text: 'Information You Provide' },
      { type: 'p', text: 'This includes information you voluntarily submit, such as:' },
      { type: 'ul', items: ['Contact form submissions', 'Emails you send directly to us'] },
      { type: 'p', text: 'This information may include your name and email address.' },
      { type: 'h3', text: 'Automatically Collected Information' },
      {
        type: 'p',
        text: 'Like most websites, we automatically collect certain information when you visit our website, including:',
      },
      {
        type: 'ul',
        items: [
          'IP address',
          'Browser type',
          'Device type',
          'Operating system',
          'Pages visited',
          'Time spent on pages',
          'Referral source',
          'General geographic location (country or city level)',
        ],
      },
      {
        type: 'p',
        text: 'This information helps us understand how visitors use our website and improve the user experience.',
      },
    ],
  },
  {
    heading: 'Cookies',
    blocks: [
      { type: 'p', text: 'This website uses cookies and similar technologies to improve your browsing experience.' },
      { type: 'p', text: 'Cookies help us:' },
      {
        type: 'ul',
        items: [
          'Remember visitor preferences',
          'Understand website performance',
          'Analyze traffic',
          'Deliver relevant advertising',
          'Measure affiliate link performance',
        ],
      },
      {
        type: 'p',
        text: 'You can disable cookies through your browser settings, although some parts of the website may not function properly.',
      },
    ],
  },
  {
    heading: 'Google Analytics',
    blocks: [
      { type: 'p', text: 'We use Google Analytics to understand how visitors interact with our website.' },
      { type: 'p', text: 'Google Analytics may collect information such as:' },
      {
        type: 'ul',
        items: ['Pages visited', 'Time on site', 'Device information', 'Approximate location', 'Traffic sources'],
      },
      { type: 'p', text: 'This information is aggregated and does not personally identify individual visitors.' },
    ],
  },
  {
    heading: 'Affiliate Links',
    blocks: [
      { type: 'p', text: 'Some pages contain affiliate links.' },
      {
        type: 'p',
        text: 'This means we may receive a small commission if you book or purchase through certain links, at no additional cost to you.',
      },
    ],
  },
  {
    heading: 'Third-Party Services',
    blocks: [
      { type: 'p', text: 'This website may use third-party services including, but not limited to:' },
      {
        type: 'ul',
        items: [
          'Google Analytics',
          'Get Your Guide',
          'Viator',
          // Revisar: listar aqui só os serviços realmente usados no site.
          'Social media platforms',
          'Embedded content such as Google Maps or YouTube',
        ],
      },
      { type: 'p', text: 'Each of these services has its own privacy practices.' },
    ],
  },
  {
    heading: 'Embedded Content',
    blocks: [
      { type: 'p', text: 'Articles on this website may include embedded content such as:' },
      { type: 'ul', items: ['Google Maps', 'YouTube videos', 'Instagram posts', 'Social media content'] },
      {
        type: 'p',
        text: 'Embedded content behaves in the same way as if you had visited the third-party website directly.',
      },
    ],
  },
  {
    heading: 'Data Security',
    blocks: [
      {
        type: 'p',
        text: 'We take reasonable measures to protect your information. However, no method of transmitting information over the Internet or electronic storage is completely secure, and we cannot guarantee absolute security.',
      },
    ],
  },
  {
    heading: "Children's Privacy",
    blocks: [
      {
        type: 'p',
        text: 'This website is not intended for children under the age of 13. We do not knowingly collect personal information from children.',
      },
      { type: 'p', text: 'If you believe a child has provided personal information, please contact us so we can remove it.' },
    ],
  },
  {
    heading: 'Your Privacy Rights',
    blocks: [
      {
        type: 'p',
        text: 'Depending on where you live, you may have rights regarding your personal information, including the right to:',
      },
      {
        type: 'ul',
        items: [
          'Request access to your personal data',
          'Request correction of inaccurate information',
          'Request deletion of your personal information',
          'Object to certain types of processing',
          'Withdraw consent where applicable',
        ],
      },
      { type: 'p', text: 'To exercise these rights, please contact us using the email provided above.' },
    ],
  },
  {
    heading: 'International Visitors',
    blocks: [
      {
        type: 'p',
        text: 'Because this website is accessible worldwide, your information may be processed in countries other than your own.',
      },
      { type: 'p', text: 'By using this website, you consent to this transfer where permitted by applicable law.' },
    ],
  },
  {
    heading: 'Changes to This Policy',
    blocks: [
      { type: 'p', text: 'We may update this Privacy Policy from time to time.' },
      {
        type: 'p',
        text: 'The latest version will always be available on this page, along with the updated effective date.',
      },
    ],
  },
  {
    heading: 'Contact',
    blocks: [
      { type: 'p', text: 'If you have any questions about this Privacy Policy, please contact:' },
      { type: 'email' },
    ],
  },
];
---

<BaseLayout title="Privacy Policy">
  <Header />

  <section class="page-header">
    <div class="container page-header-inner">
      <h1>Privacy Policy</h1>
      <p class="text-secondary last-updated">Last updated: {lastUpdated}</p>
    </div>
  </section>

  <main class="container page-content">
    {
      sections.map((section) => (
        <section class="policy-section">
          <h2>{section.heading}</h2>
          {section.blocks.map((block) => {
            if (block.type === 'p') return <p>{block.text}</p>;
            if (block.type === 'h3') return <h3>{block.text}</h3>;
            if (block.type === 'email')
              return (
                <p>
                  Email: <a class="policy-email" href={`mailto:${contactEmail}`}>{contactEmail}</a>
                </p>
              );
            return (
              <ul>
                {block.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            );
          })}
        </section>
      ))
    }
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    background: var(--color-background-highlight);
  }

  .page-header-inner {
    max-width: var(--article-max);
    padding-block: var(--space-5) var(--space-4);
  }

  .page-content {
    max-width: var(--article-max);
    padding-block: var(--space-5) var(--space-6);
  }

  .last-updated {
    margin: 0;
  }

  .policy-section {
    margin-top: var(--space-5);
  }

  .policy-section h3 {
    font-size: 1.125rem;
    margin-top: var(--space-4);
  }

  .policy-section ul {
    margin: 0 0 var(--space-3);
    padding-left: var(--space-4);
  }

  .policy-section li {
    margin-bottom: var(--space-1);
  }

  .policy-email {
    color: var(--color-link);
    font-weight: 600;
  }
</style>
