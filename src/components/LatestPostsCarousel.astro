---
import { getAllPostCards } from '../lib/sanity';
import { useTranslations, defaultLang, type Locale } from '../i18n/utils';

const t = useTranslations((Astro.currentLocale as Locale) ?? defaultLang);

// Já vem ordenado por updatedAt desc (ver getAllPostCards) — sem filtro de
// categoria, todos os posts entram aqui.
const latestPosts = await getAllPostCards();
---

<section class="latest-posts-section">
  <div class="container">
    <div class="latest-posts-header">
      <div>
        <h2>{t('home.latestPosts')}</h2>
      </div>
      <div class="carousel-controls">
        <button class="carousel-btn" id="carousel-prev" type="button" aria-label={t('carousel.prev')}>‹</button>
        <button class="carousel-btn" id="carousel-next" type="button" aria-label={t('carousel.next')}>›</button>
      </div>
    </div>

    <div class="carousel-track" id="latest-posts-track">
      {
        latestPosts.map((post) => (
          <a class="post-card" href={`/blog/${post.slug}/`}>
            {post.coverImageUrl ? (
              <img class="post-card-image" src={post.coverImageUrl} alt="" loading="lazy" />
            ) : (
              <div class="post-card-image" />
            )}
            <div class="post-card-body">
              <span class="category-label">{post.category}</span>
              <span class="post-card-title">{post.title}</span>
            </div>
          </a>
        ))
      }
    </div>

    <a class="see-all-button button" href="/blog/">{t('home.seeAllPosts')} →</a>
  </div>
</section>

<style>
  .latest-posts-section {
    background: var(--color-background);
    padding-block: var(--space-6);
  }

  .latest-posts-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .see-all-button {
    display: block;
    width: fit-content;
    margin: var(--space-5) auto 0;
    background: var(--color-primary);
    color: var(--color-background);
    padding: var(--space-3) var(--space-5);
    text-decoration: none;
    text-align: center;
  }

  .carousel-controls {
    display: flex;
    gap: var(--space-2);
  }

  .carousel-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    color: var(--color-text);
  }

  .carousel-btn:hover {
    background: var(--color-background-highlight);
  }

  .carousel-track {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: var(--space-2);
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  .post-card {
    flex: 0 0 200px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-text);
  }

  /* Mesmo padrão da página do blog (ver BlogPostCard.astro): imagem com os
     4 cantos arredondados "na frente", cartão branco colado embaixo dela
     (arredondado só nos cantos de baixo), avançando por trás da imagem pra
     não sobrar vão nos cantos curvos. */
  .post-card-image {
    display: block;
    width: 100%;
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--color-border);
    border-radius: 12px;
  }

  .post-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    background: #ffffff;
    padding: var(--space-2);
    padding-top: calc(var(--space-2) + 12px);
    margin-top: -12px;
    border-radius: 0 0 12px 12px;
  }

  .post-card-title {
    font-weight: 600;
    font-size: var(--fs-secondary-mobile);
  }

  @media (min-width: 768px) {
    .post-card {
      flex-basis: calc((100% - 4 * var(--space-3)) / 5);
    }
  }
</style>

<script>
  const track = document.getElementById('latest-posts-track');
  const prevButton = document.getElementById('carousel-prev');
  const nextButton = document.getElementById('carousel-next');

  function scrollByCard(direction: 1 | -1) {
    const card = track?.querySelector<HTMLElement>('.post-card');
    if (!track || !card) return;
    const gap = parseFloat(getComputedStyle(track).gap || '0');
    track.scrollBy({ left: direction * (card.offsetWidth + gap), behavior: 'smooth' });
  }

  prevButton?.addEventListener('click', () => scrollByCard(-1));
  nextButton?.addEventListener('click', () => scrollByCard(1));
</script>
