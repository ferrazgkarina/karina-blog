---
import type { PostData } from '../lib/sanity';
import { useTranslations, defaultLang, type Locale } from '../i18n/utils';

interface Props {
  post: PostData;
}

const { post } = Astro.props;
const lang = (Astro.currentLocale as Locale) ?? defaultLang;
const t = useTranslations(lang);

// updatedAt é opcional no schema (nem todo post precisa mostrar essa data).
const formattedDate = post.updatedAt
  ? new Date(post.updatedAt).toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

<section class="post-header">
  <div class="container post-header-inner">
    <nav aria-label={t('breadcrumb.ariaLabel')} class="breadcrumb">
      <ol>
        <li><a href="/">{t('breadcrumb.home')}</a></li>
        <li><a href={`/blog/?category=${encodeURIComponent(post.category)}`}>{post.category}</a></li>
        <li aria-current="page">{post.title}</li>
      </ol>
    </nav>
    <p class="category-label category-pill">{post.category}</p>
    <h1>{post.title}</h1>
    <p class="teaser">{post.teaser}</p>
    <p class="byline text-secondary">
      {t('byline.writtenBy')} <strong>{post.author}</strong>
      {formattedDate && (
        <>
          | {t('byline.updated')} {formattedDate}
        </>
      )}
    </p>
  </div>
</section>

<div class="container cover-image-wrap">
  {
    post.coverImageUrl ? (
      <img class="cover-image" src={post.coverImageUrl} alt={`Cover photo for ${post.title}`} width="1400" height="1050" />
    ) : (
      <div class="cover-image" role="img" aria-label={`Cover photo for ${post.title}`} />
    )
  }
</div>

<style>
  .post-header {
    background: var(--color-background-highlight);
    color: var(--color-text);
  }

  .post-header-inner {
    padding-block: var(--space-5) var(--space-4);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    font-size: var(--fs-secondary-mobile);
  }

  .breadcrumb li:not(:last-child)::after {
    content: '›';
    margin-left: var(--space-1);
  }

  .breadcrumb a {
    color: var(--color-text);
    text-decoration: underline;
  }

  /* Mesma cor do botão "+" do ComingNextBar (var(--color-secondary)). */
  .category-pill {
    display: inline-block;
    background: var(--color-secondary);
    color: var(--color-text);
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
  }

  .teaser {
    font-style: italic;
    font-weight: 500;
    font-size: var(--fs-body-mobile);
    max-width: var(--article-max);
  }

  @media (min-width: 768px) {
    .teaser {
      font-size: var(--fs-body);
    }
  }

  .byline {
    margin: 0;
  }

  .cover-image {
    display: block;
    width: 100%;
    height: auto;
    max-width: var(--article-max);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    /* Placeholder de fundo — só aparece quando não há imagem cadastrada. */
    background: linear-gradient(135deg, var(--color-secondary), var(--color-background-highlight));
  }
</style>
