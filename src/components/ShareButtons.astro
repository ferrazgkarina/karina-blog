---
import { useTranslations, defaultLang, type Locale } from '../i18n/utils';

// Instagram não entra: a rede não tem um endpoint de compartilhamento por URL
// como Facebook/WhatsApp (não dá pra abrir um post pré-preenchido a partir de
// um site) — decisão da usuária foi deixar só as duas redes com share real.
const t = useTranslations((Astro.currentLocale as Locale) ?? defaultLang);
---

<div class="share-buttons">
  <span class="share-label text-secondary">{t('share.label')}</span>
  <ul>
    <li>
      <button class="share-button" type="button" data-network="facebook" aria-label={`${t('share.onNetwork')} Facebook`}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path
            d="M15 8.5h2.5V5.2c-.43-.06-1.9-.2-3.6-.2-3.57 0-6 2.24-6 6.35V15H4.5v3.8H7.9V24h3.8v-5.2h3.27l.52-3.8h-3.79v-3.2c0-1.1.3-1.85 1.8-1.85Z"
          />
        </svg>
      </button>
    </li>
    <li>
      <button class="share-button" type="button" data-network="whatsapp" aria-label={`${t('share.onNetwork')} WhatsApp`}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path
            d="M12 2C6.48 2 2 6.48 2 12c0 1.87.51 3.62 1.4 5.12L2 22l5.05-1.36A9.94 9.94 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2Zm0 18.06c-1.6 0-3.11-.44-4.4-1.21l-.31-.18-3.05.82.82-2.97-.2-.31A7.98 7.98 0 0 1 4 12c0-4.42 3.58-8 8-8s8 3.58 8 8-3.58 8.06-8 8.06Zm4.38-5.98c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.01-.37-1.92-1.19-.71-.63-1.19-1.41-1.33-1.65-.14-.24-.01-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.19-.46-.39-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.13 3.64.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z"
          />
        </svg>
      </button>
    </li>
  </ul>
</div>

<style>
  .share-buttons {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .share-buttons ul {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .share-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    color: var(--color-primary);
    cursor: pointer;
  }

  .share-button:hover {
    background: var(--color-background-highlight);
  }
</style>

<script>
  // Lido no momento do clique (não via props) porque este componente é usado
  // tanto na Sidebar quanto no painel mobile do ComingNextBar — self-contained
  // evita ter que passar título/URL por dois componentes pai diferentes.
  function shareUrls() {
    const url = window.location.href;
    const title = document.title;
    return {
      facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
      whatsapp: `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}`,
    };
  }

  document.querySelectorAll<HTMLButtonElement>('.share-button').forEach((button) => {
    button.addEventListener('click', () => {
      const network = button.dataset.network as 'facebook' | 'whatsapp';
      const shareUrl = shareUrls()[network];
      window.open(shareUrl, 'share-popup', 'width=600,height=500,noopener,noreferrer');
    });
  });
</script>
