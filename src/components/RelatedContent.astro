---
import type { RelatedPostRef } from '../lib/sanity';
import { useTranslations, defaultLang, type Locale } from '../i18n/utils';

interface Props {
  posts: RelatedPostRef[];
}

const { posts } = Astro.props;
const t = useTranslations((Astro.currentLocale as Locale) ?? defaultLang);
---

<div class="related-content">
  <h3>{t('relatedContent.heading')}</h3>
  <ul>
    {
      posts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}/`}>
            <span class="category-label">{post.category}</span>
            <span class="related-title">{post.title}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .related-content h3 {
    margin-bottom: var(--space-3);
  }

  .related-content ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .related-content a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-decoration: none;
    color: var(--color-text);
  }

  .related-content .category-label {
    color: var(--color-tertiary);
  }

  .related-title {
    font-weight: 600;
  }

  .related-content a:hover .related-title {
    text-decoration: underline;
  }
</style>
