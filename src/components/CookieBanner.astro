---
---

<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Cookie consent" hidden>
  <p>
    We use cookies to understand how the site is used. You can accept or decline analytics cookies.
    <a href="/privacy-policy/">Privacy Policy</a>
  </p>
  <div class="cookie-actions">
    <button type="button" id="cookie-decline" class="cookie-button cookie-decline">Decline</button>
    <button type="button" id="cookie-accept" class="cookie-button cookie-accept">Accept</button>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    left: var(--space-3);
    right: var(--space-3);
    bottom: var(--space-3);
    z-index: 40;
    max-width: 420px;
    background: var(--color-primary);
    color: var(--color-background);
    border-radius: 12px;
    padding: var(--space-3) var(--space-4);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    font-size: var(--fs-secondary-mobile);
  }

  .cookie-banner[hidden] {
    display: none;
  }

  .cookie-banner p {
    margin: 0 0 var(--space-3);
  }

  .cookie-banner a {
    color: var(--color-secondary);
    text-decoration: underline;
  }

  .cookie-actions {
    display: flex;
    gap: var(--space-2);
    justify-content: flex-end;
  }

  .cookie-button {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--fs-secondary-mobile);
    padding: var(--space-2) var(--space-3);
    border-radius: 8px;
    cursor: pointer;
  }

  .cookie-accept {
    background: var(--color-secondary);
    color: var(--color-primary);
    border: 1px solid var(--color-secondary);
  }

  .cookie-decline {
    background: transparent;
    color: var(--color-background);
    border: 1px solid var(--color-background);
  }
</style>

<script>
  const GA_ID = import.meta.env.PUBLIC_GA_ID ?? '';
  const STORAGE_KEY = 'cookie-consent';

  function readConsent(): string | null {
    try {
      return localStorage.getItem(STORAGE_KEY);
    } catch {
      return null;
    }
  }

  function saveConsent(value: 'granted' | 'denied') {
    try {
      localStorage.setItem(STORAGE_KEY, value);
    } catch {
      // Navegador bloqueou o armazenamento: a escolha vale só nesta página.
    }
  }

  function loadAnalytics() {
    const w = window as any;
    if (w.__gaLoaded) return;
    w.__gaLoaded = true;
    w.dataLayer = w.dataLayer || [];
    w.gtag = function () {
      w.dataLayer.push(arguments);
    };
    w.gtag('js', new Date());
    w.gtag('config', GA_ID);
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
    document.head.appendChild(script);
  }

  const banner = document.getElementById('cookie-banner');
  const consent = readConsent();

  // Sem ID de analytics configurado, não há o que consentir: o aviso nunca aparece.
  if (!GA_ID) {
    // nada a fazer
  } else if (consent === 'granted') {
    loadAnalytics();
  } else if (consent !== 'denied' && banner) {
    // Nos posts, a barra "Coming next" já ocupa o rodapé: o aviso sobe acima dela.
    const bar = document.querySelector<HTMLElement>('.coming-next-bar');
    if (bar) {
      banner.style.bottom = `${bar.getBoundingClientRect().height + 12}px`;
    }
    banner.hidden = false;

    document.getElementById('cookie-accept')?.addEventListener('click', () => {
      saveConsent('granted');
      banner.hidden = true;
      loadAnalytics();
    });
    document.getElementById('cookie-decline')?.addEventListener('click', () => {
      saveConsent('denied');
      banner.hidden = true;
    });
  }
</script>
