---
import type { RelatedPostRef } from '../lib/sanity';
import { useTranslations, defaultLang, type Locale } from '../i18n/utils';

interface Props {
  posts: RelatedPostRef[];
}

const { posts } = Astro.props;
const t = useTranslations((Astro.currentLocale as Locale) ?? defaultLang);
---

<div class="suggested-posts">
  <h3>{t('suggestedPosts.heading')}</h3>
  <div class="suggested-grid">
    {
      posts.map((post) => (
        <a class="suggested-card" href={`/blog/${post.slug}/`}>
          {post.coverImageUrl ? (
            <img class="suggested-card-image" src={post.coverImageUrl} alt="" loading="lazy" />
          ) : (
            <div class="suggested-card-image" />
          )}
          <div class="suggested-card-body">
            <span class="category-label">{post.category}</span>
            <span class="suggested-card-title">{post.title}</span>
          </div>
        </a>
      ))
    }
  </div>
</div>

<style>
  .suggested-posts {
    margin-block: var(--space-5);
  }

  .suggested-posts h3 {
    margin-bottom: var(--space-3);
  }

  /* Mobile: lado a lado com scroll horizontal (mesmo padrão das seções
     Seasons/Plan your trip), em vez de empilhar. Desktop: grid de 3, lado a
     lado sem scroll (cabe inteiro na coluna do artigo). */
  .suggested-grid {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: var(--space-1);
  }

  .suggested-grid::-webkit-scrollbar {
    display: none;
  }

  /* Mesmo padrão visual dos cards da Home/Blog: imagem com os 4 cantos
     arredondados "na frente", cartão branco avançando por baixo dela. */
  .suggested-card {
    flex: 0 0 200px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-text);
  }

  .suggested-card-image {
    display: block;
    width: 100%;
    position: relative;
    z-index: 1;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--color-border);
    border-radius: 12px;
  }

  .suggested-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    background: #ffffff;
    padding: var(--space-3);
    padding-top: calc(var(--space-3) + 12px);
    margin-top: -12px;
    border-radius: 0 0 12px 12px;
  }

  .suggested-card-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .suggested-card:hover .suggested-card-title {
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .suggested-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      overflow-x: visible;
    }

    .suggested-card {
      flex: initial;
    }
  }
</style>
