---
import { seasonCards } from '../data/seasons';
import { useTranslations, defaultLang, type Locale } from '../i18n/utils';

const t = useTranslations((Astro.currentLocale as Locale) ?? defaultLang);
---

<section class="seasons-section">
  <div class="container">
    <div class="seasons-header">
      <div>
        <h2>{t('home.seasonsHeading')}</h2>
      </div>
      <div class="seasons-controls">
        <button class="carousel-btn" id="seasons-prev" type="button" aria-label={t('carousel.prev')}>‹</button>
        <button class="carousel-btn" id="seasons-next" type="button" aria-label={t('carousel.next')}>›</button>
      </div>
    </div>
    <div class="seasons-grid" id="seasons-grid">
      {
        seasonCards.map((card) => (
          <a class:list={['season-card', { hub: card.isHub }]} href={card.href}>
            {card.icon ? (
              <img class="season-card-image" src={card.icon} alt={card.label} loading="lazy" />
            ) : (
              <>
                <div class="season-card-image" />
                <span class="season-card-label">{card.label}</span>
              </>
            )}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .seasons-section {
    background: var(--color-background);
  }

  .seasons-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-6) var(--space-5);
  }

  .seasons-header p {
    max-width: 460px;
  }

  /* Só faz sentido no mobile, onde os cards ficam numa linha com scroll —
     no desktop o grid mostra as 4 estações de uma vez, sem precisar rolar. */
  .seasons-controls {
    display: flex;
    gap: var(--space-2);
  }

  .carousel-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    color: var(--color-text);
  }

  .carousel-btn:hover {
    background: #ffffff;
  }

  /* Mobile: scroll horizontal nativo, os 4 cards lado a lado sem empilhar.
     Desktop: vira grid de 4 colunas fixas, sem scroll (ver media query). */
  .seasons-grid {
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: var(--space-6);
  }

  .seasons-grid::-webkit-scrollbar {
    display: none;
  }

  .season-card {
    display: flex;
    flex-direction: column;
    flex: 0 0 150px;
    scroll-snap-align: start;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-text);
  }

  .season-card-image {
    aspect-ratio: 3 / 4;
    width: 100%;
    background: var(--color-border);
    border-radius: 4px;
    object-fit: cover;
  }

  .season-card.hub .season-card-image {
    background: var(--color-secondary);
  }

  .season-card-label {
    font-weight: 600;
    font-size: var(--fs-secondary-mobile);
  }

  @media (min-width: 768px) {
    .seasons-controls {
      display: none;
    }

    .seasons-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      overflow-x: visible;
    }

    .season-card {
      flex: initial;
    }
  }
</style>

<script>
  const track = document.getElementById('seasons-grid');
  const prevButton = document.getElementById('seasons-prev');
  const nextButton = document.getElementById('seasons-next');

  function scrollByCard(direction: 1 | -1) {
    const card = track?.querySelector<HTMLElement>('.season-card');
    if (!track || !card) return;
    const gap = parseFloat(getComputedStyle(track).gap || '0');
    track.scrollBy({ left: direction * (card.offsetWidth + gap), behavior: 'smooth' });
  }

  prevButton?.addEventListener('click', () => scrollByCard(-1));
  nextButton?.addEventListener('click', () => scrollByCard(1));
</script>
